+def _pick_location(matches, country, original_city, variant):
+    """Rank geocoder hits: right country, matching province, exact name, population."""
+    original_words = [_fold_tr(word) for word in _strip_locative(original_city).split()]
+
+    def score(result):
+        value = 0.0
+        if country and (result.get("country_code") or "").upper() == country:
+            value += 100.0
+        admin1 = _fold_tr(result.get("admin1") or "")
+        for word in original_words:
+            if word and len(word) >= 3 and (word in admin1 or (admin1 and admin1 in word)):
+                value += 40.0
+        name = _fold_tr(result.get("name") or "")
+        if name == _fold_tr(variant):
+            value += 25.0
+        elif name and (name in _fold_tr(variant) or _fold_tr(variant) in name):
+            value += 10.0
+        value += min(float(result.get("population") or 0), 2_000_000.0) / 100_000.0
+        return value
+
+    return max(matches, key=score)
